// Prisma schema for Antrian-TGX

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Menu {
  id        Int      @id @default(autoincrement())
  name      String
  category  String   @default("Martabak") // "Martabak" | "Terang Bulan"
  price     Int      @default(0)
  image     String?
  available Boolean  @default(true)
  createdAt DateTime @default(now())
  items     QueueItem[]
}

model Queue {
  id         Int         @id @default(autoincrement())
  number     Int
  customer   String
  status     String      @default("waiting") // waiting | cooking | done
  createdAt  DateTime    @default(now())
  items      QueueItem[]
}

model QueueItem {
  id       Int   @id @default(autoincrement())
  queueId  Int
  queue    Queue @relation(fields: [queueId], references: [id], onDelete: Cascade)
  menuId   Int
  menu     Menu  @relation(fields: [menuId], references: [id])
  quantity Int   @default(1)
}
